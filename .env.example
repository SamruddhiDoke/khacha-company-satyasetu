# Copy to .env (never commit .env). All keys stay on the backend container.

# --- Required for live verification -----------------------------------------
# Gemini API key from https://aistudio.google.com/apikey (free tier; do NOT enable billing
# unless you intend to pay). Free-tier content may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Tavily key from https://app.tavily.com (free plan: 1,000 credits/month; one basic search = 1 credit)
TAVILY_API_KEY=

# --- Optional -----------------------------------------------------------------
# Google Fact Check Tools API key (free; enable "Fact Check Tools API" in a Google Cloud project)
FACTCHECK_API_KEY=

# --- Free-quota guards (requests are refused locally before these are exceeded) ---
GEMINI_MAX_REQUESTS_PER_MINUTE=8
GEMINI_MAX_REQUESTS_PER_DAY=200
TAVILY_MAX_SEARCHES_PER_DAY=40
TAVILY_MAX_SEARCHES_PER_MONTH=900

# --- Per-check limits ------------------------------------------------------------
MAX_CLAIMS_PER_CHECK=4
MAX_SEARCHES_PER_CLAIM=2
MAX_TOTAL_SEARCHES_PER_CHECK=6
CHECK_TIMEOUT_S=180

# --- Media & retention -----------------------------------------------------------
WHISPER_ENABLED=true
WHISPER_MODEL=base
RETENTION_DAYS=30

# Local database password (only reachable inside the Docker network)
POSTGRES_PASSWORD=satyasetu-local
